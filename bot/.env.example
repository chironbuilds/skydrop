BSKY_HANDLE=your-bot.bsky.social
BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Public URL of the hosted web app (no trailing slash). Required for live mode.
CLAIM_URL=
# Set to 1 to actually post. Anything else is a dry run.
BOT_LIVE=0
# Smallest total (in micro-tTARI) worth a mention.
NOTIFY_MIN=1000
# Comma-separated DIDs that are always notified (testing).
ALWAYS_NOTIFY=
# Recovery key of the account that signs tip relays. It needs no funds.
OOTLE_SEED=
