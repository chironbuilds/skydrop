[Unit]
Description=Skydrop Bluesky notifier bot (reads the BskyClaim escrow, mentions recipients; holds no funds or Ootle keys)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/skydrop-bot/bot
ExecStart=/usr/bin/npx tsx index.ts
Restart=always
RestartSec=15
User=skydrop
Group=skydrop
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/skydrop-bot/bot
PrivateTmp=true

[Install]
WantedBy=multi-user.target
