{
  "name": "skydrop",
  "compatibility_date": "2026-10-01",
  "main": "./worker/index.ts",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "kv_namespaces": [{ "binding": "COVERS", "id": "434c3d7a147e47f6beeadf0b75fbec1f" }, { "binding": "LAUNCH_STATE", "id": "58ad9c6377eb450bbccac4b9ef8448ac" }],
  "routes": [{ "pattern": "skydrop.tari.mw", "custom_domain": true }],
  // Starts on the testnet and moves to mainnet by itself at launch (web-atproto/worker/network.ts). Deploy after npm run build:all.
  "define": { "__SKYDROP_NETWORK__": "\"auto\"" },
  "env": {
    "testnet": {
      "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
      "kv_namespaces": [{ "binding": "COVERS", "id": "434c3d7a147e47f6beeadf0b75fbec1f" }],
      "routes": [{ "pattern": "testnet-skydrop.tari.mw", "custom_domain": true }],
      "define": { "__SKYDROP_NETWORK__": "\"esmeralda\"" }
    }
  }
}
